# TorrPlay desktop settings. Quit and reopen TorrPlay after changing them.

# Extra HTTP hostnames, separated by commas. Wildcards allow all names
# beneath the suffix. Use them for DNS zones you control.
#TORRPLAY_ALLOWED_HOSTS=torrplay,*.home.arpa

# The API's address. Until a password is set, only local networks may use
# it. Default: [::]:8642, every interface.
#TORRPLAY_LISTEN=[::]:8642

# The log's format, text or json.
# Default: text in a terminal, json otherwise.
#TORRPLAY_LOG_FORMAT=text
