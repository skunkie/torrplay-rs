<!-- Installed as /usr/lib/firewalld/services/torrplay.xml, which the
     administrator enables with firewall-cmd's add-service option, as the
     manual page shows; an XML comment cannot hold the option itself. -->
<service>
  <short>TorrPlay</short>
  <description>The TorrPlay service's API and web client, its BitTorrent peer port, for TCP and for UDP, which the DHT uses too, and SSDP, which its DLNA media server answers on, at their default ports.</description>
  <port protocol="tcp" port="8642"/>
  <port protocol="tcp" port="4240"/>
  <port protocol="udp" port="4240"/>
  <port protocol="udp" port="1900"/>
</service>
