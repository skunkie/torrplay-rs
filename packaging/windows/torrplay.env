# TorrPlay service settings, installed as %ProgramData%\TorrPlay\torrplay.env.
# The service reads them on start, so restart it after a change, in Services
# or with `Restart-Service torrplay`. Each is a NAME=value line; a line
# starting with # is a comment.

# Extra HTTP hostnames, separated by commas. Wildcards allow all names
# beneath the suffix. Use them for DNS zones you control.
#TORRPLAY_ALLOWED_HOSTS=torrplay,*.home.arpa

# The directory for torrents in disk storage. Default: downloads beside this file.
# Grant NT SERVICE\torrplay Modify permission on a custom directory.
# Apply the permission to files and subdirectories through inheritance.
#TORRPLAY_DOWNLOAD_DIR="D:\TorrPlay Downloads"

# The API's address. Until a password is set, only local networks may use
# it. The client reads it here too, so it finds a service on another port.
# Default: [::]:8642, every interface.
#TORRPLAY_LISTEN=[::]:8642

# The format for standard error, text or json. Default: json.
# Files in the logs directory always use JSON Lines.
#TORRPLAY_LOG_FORMAT=text
