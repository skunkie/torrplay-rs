# TorrPlay service settings, installed as %ProgramData%\TorrPlay\torrplay.env.
# The service reads them on start, so restart it after a change, in Services
# or with `Restart-Service torrplay`. Each is a NAME=value line; a line
# starting with # is a comment.

# The API's address. Until a password is set, only local networks may use
# it. The client reads it here too, so it finds a service on another port.
# Default: [::]:8642, every interface.
#TORRPLAY_LISTEN=[::]:8642

# The log's format, text or json. The service logs to the logs directory
# beside this file. Default: json, since a service has no terminal.
#TORRPLAY_LOG_FORMAT=text
