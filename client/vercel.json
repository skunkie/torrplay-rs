{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/", "destination": "/demo", "permanent": false }],
  "rewrites": [{ "source": "/demo/:path*{/}?", "destination": "/index.html" }]
}
