{
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis",
      "appimage"
    ],
    "externalBin": [
      "binaries/torrplay"
    ],
    "category": "Video",
    "shortDescription": "Stream torrents to browsers, players, and televisions",
    "longDescription": "TorrPlay streams torrents to browsers, players, and televisions while\ntheir pieces arrive. This is its application: the window, the server,\nand a DLNA media server in one program, which runs while it is open,\nwith the torrplay command beside it for MCP clients and backups.",
    "linux": {
      "deb": {
        "section": "video",
        "conflicts": [
          "torrplay-service"
        ],
        "recommends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ],
        "desktopTemplate": "../packaging/linux/torrplay-desktop.desktop",
        "files": {
          "/usr/share/man/man1/torrplay.1.gz": "../target/man/torrplay.1.gz",
          "/usr/share/doc/torrplay/copyright": "../LICENSES/MIT.txt",
          "/usr/share/doc/torrplay/THIRD-PARTY-NOTICES.txt": "../target/notices/THIRD-PARTY-NOTICES.txt"
        }
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/share/doc/torrplay/copyright": "../LICENSES/MIT.txt",
          "/usr/share/doc/torrplay/THIRD-PARTY-NOTICES.txt": "../target/notices/THIRD-PARTY-NOTICES.txt",
          "/usr/share/doc/torrplay/APPIMAGE-RUNTIME-NOTICES.txt": "../packaging/linux/appimage-runtime-notices.txt"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../packaging/windows/application.nsh"
      }
    }
  }
}
